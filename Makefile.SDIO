# SPDX-License-Identifier: Apache-2.0
# SDIO Open IP -- sim & synthesis entry points
S      := SDIO
DEPS   := 
SIM    ?= iverilog
VFLAGS := -g2012 -Wall
SYN    ?= yosys

all: sim syn

sim:
	$(SIM) $(VFLAGS) -o simv rtl/$(S)_top.sv $(DEPS) tb/$(S)_tb.sv
	./simv

# functional sim at BIT_CLKS=4 (divided bit rate)
sim_bitclks:
	$(SIM) $(VFLAGS) -o simv_bitclks rtl/$(S)_top.sv $(DEPS) tb/$(S)_bitclks_tb.sv
	./simv_bitclks

syn:
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_yosys.ys

apb:
	$(SIM) $(VFLAGS) -I tb -o simv_apb rtl/$(S)_top.sv $(DEPS) rtl/$(S)_apb.sv tb/$(S)_apb_tb.sv
	./simv_apb
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_apb_yosys.ys

clean:
	rm -f simv simv_apb simv_bitclks *.vcd work/*.json work/*_netlist.v
.PHONY: all sim sim_bitclks syn clean
