# LPDDR5X_Lite synthesis script -- Yosys (open-source flow)
# The line array is kept as a $mem cell (memory -nomap): in a real flow it
# maps to an SRAM macro, and flattening it to flops (~2M DFFs) is not a
# meaningful result for this open flow.
read_verilog -sv ../rtl/LPDDR5X_Lite_top.sv
hierarchy -check -top LPDDR5X_Lite_top
proc; opt; fsm; opt; memory -nomap; opt
techmap; opt
stat
write_json LPDDR5X_Lite_top.json
write_verilog LPDDR5X_Lite_top_netlist.v
