# PCIe_CXL_IDE synthesis script -- Yosys (open-source flow)
read_verilog -sv ../rtl/PCIe_CXL_IDE_top.sv ../rtl/AES_GCM_top.sv
hierarchy -check -top PCIe_CXL_IDE_top
proc; opt; fsm; opt
techmap; opt
stat
write_json PCIe_CXL_IDE_top.json
write_verilog PCIe_CXL_IDE_top_netlist.v
