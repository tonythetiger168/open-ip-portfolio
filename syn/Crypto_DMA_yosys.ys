# Crypto_DMA synthesis script -- Yosys (open-source flow)
read_verilog -sv ../rtl/Crypto_DMA_top.sv ../rtl/soc_ss_axi_engine.sv ../rtl/AES_GCM_top.sv
hierarchy -check -top Crypto_DMA_top
proc; opt; fsm; opt; memory; opt
techmap; opt
stat
write_json Crypto_DMA_top.json
write_verilog Crypto_DMA_top_netlist.v
