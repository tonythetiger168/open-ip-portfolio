# ARM Serial Wire Debug synthesis script -- Yosys (open-source flow)
read_verilog -sv ../rtl/ARM_Serial_Wire_Debug_top.sv 
hierarchy -check -top ARM_Serial_Wire_Debug_top
proc; opt; fsm; opt; memory; opt
techmap; opt
stat
write_json ARM_Serial_Wire_Debug_top.json
write_verilog ARM_Serial_Wire_Debug_top_netlist.v
