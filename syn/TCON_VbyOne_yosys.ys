# TCON_VbyOne synthesis script -- Yosys (open-source flow)
read_verilog -sv ../rtl/TCON_VbyOne_top.sv ../rtl/soc_ss_axi_engine.sv ../rtl/tv_fifo.sv
hierarchy -check -top TCON_VbyOne_top
proc; opt; fsm; opt; memory; opt
techmap; opt
stat
write_json TCON_VbyOne_top.json
write_verilog TCON_VbyOne_top_netlist.v
