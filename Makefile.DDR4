# SPDX-License-Identifier: Apache-2.0
# DDR4 Open IP -- sim & synthesis entry points
S      := DDR4
DEPS   :=
SIM    ?= iverilog
VFLAGS := -g2012 -Wall -I tb
SYN    ?= yosys

all: sim syn

sim:
	$(SIM) $(VFLAGS) -o simv rtl/$(S)_top.sv $(DEPS) tb/$(S)_tb.sv
	./simv

syn:
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_yosys.ys

apb:
	$(SIM) $(VFLAGS) -I tb -o simv_apb rtl/$(S)_top.sv $(DEPS) rtl/$(S)_apb.sv tb/$(S)_apb_tb.sv
	./simv_apb
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_apb_yosys.ys

# pin-level / cycle-exact functional test (tb/func)
func:
	$(SIM) $(VFLAGS) -I tb/func -o simv_func rtl/$(S)_top.sv $(DEPS) tb/func/func_ddr4_tb.sv
	./simv_func

clean:
	rm -f simv simv_apb simv_func *.vcd work/*.json work/*_netlist.v
.PHONY: all sim syn apb func clean
