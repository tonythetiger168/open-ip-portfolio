# SPDX-License-Identifier: Apache-2.0
# ML_DSA Open IP -- sim & synthesis entry points
S      := ML_DSA
DEPS   := 
SIM    ?= iverilog
VFLAGS := -g2012 -Wall
SYN    ?= yosys

all: sim syn

sim:
	$(SIM) $(VFLAGS) -o simv rtl/$(S)_top.sv $(DEPS) tb/$(S)_tb.sv
	./simv

syn:
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_yosys.ys

apb:
	$(SIM) $(VFLAGS) -I tb -o simv_apb rtl/$(S)_top.sv $(DEPS) rtl/$(S)_apb.sv tb/$(S)_apb_tb.sv
	./simv_apb
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_apb_yosys.ys

# test vectors (tb/ML_DSA_vec.hex) from the FIPS 204 model; NIST ACVP files
# (ML-DSA keyGen, sigGen and sigVer internalProjection.json) can be added with ACVP=...
vec:
	python3 scripts/mldsa/gen_vec.py tb/$(S)_vec.hex 1 $(ACVP)

clean:
	rm -f simv simv_apb *.vcd work/*.json work/*_netlist.v
.PHONY: all sim syn apb vec clean
