waiver cpri-line-7 rtl/CPRI_v8_0__eCPRI_over_CPR__top.sv:373-381 line \
  reason="5.006 attribution artifact on the ST_ALIGN stray-comma/no-comma arms; execution proven by loss-of-sync recovery back through ALIGN (CHECK 8, FSM_COV 3/3)."
waiver cpri-line-8 rtl/CPRI_v8_0__eCPRI_over_CPR__top.sv:414 line \
