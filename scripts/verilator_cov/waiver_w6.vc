# v2.5 W6-rest wave coverage waivers (verilator_coverage-style records)
# One record per waived point: ID / file:line / metric / justification.
# Cross-referenced in docs/coverage/W6_REST.md. verilator_coverage 5.006 has
# no -waiver flag, so this file is the source of truth for manual/tooling
# exclusion, same convention as waiver.vc.

# ---- UART ----
waiver uart-line-1 rtl/UART_top.sv:83   line \
  reason="default: tstate <= TX_IDLE is dead; tstate is 2-bit with all 4 encodings cased explicitly."
waiver uart-line-2 rtl/UART_top.sv:134  line \
  reason="default: rstate <= RX_IDLE is dead; rstate is 2-bit with all 4 encodings cased explicitly."
waiver uart-toggle-1 rtl/UART_top.sv:24 toggle \
  reason="div_cnt[15:5]: baud divider counts 0..DIV16-1 with DIV16=(CLK_FREQ/BAUD)/16=31 in the coverage build (BAUD=100k); upper bits are 16-bit generic headroom, unreachable at any practical baud (DIV16>=2^11 would need multi-ms bit times)."
waiver uart-toggle-2 rtl/UART_top.sv:44 toggle \
  reason="tbit[3]: TX bit counter wraps at 4'd7 (8N1), bit 3 never set by any reachable stimulus."
waiver uart-toggle-3 rtl/UART_top.sv:101 toggle \
  reason="rbit[3]: RX bit counter wraps at 4'd7 (8N1), bit 3 never set by any reachable stimulus."

# ---- JTAG ----
waiver jtag-line-1 rtl/JTAG_top.sv:51  line \
  reason="default: tap_q <= TLR is dead; tap_q is a 4-bit enum with all 16 encodings cased explicitly."

# ---- QSPI ----
waiver qspi-toggle-1 rtl/QSPI_top.sv:27 toggle \
  reason="qcnt[1]: quad nibble counter wraps at 2'd1 (two nibbles per 8-bit frame), bit 1 never set by any reachable stimulus."
# QSPI RTL-BUG (recorded, not fixed): std mode drives io[0] with tx_q[4]
# because assign io = io_oe ? io_out : 4'bzzzz uses the OE vector as a
# boolean; MOSI corrupted when tx_q[4]=1. Demonstrated in tb/QSPI_tb.sv.

# ---- PWM ----
waiver pwm-toggle-1 rtl/PWM_top.sv:24  toggle \
  reason="counter[31:22]: bit k of the free-running counter toggles only in a single period >= 2^(k+1) clocks; bits 22..31 need >= 4M..2G-cycle runs, impractical under --timing. Carry chain proven through bit 21 by the 2^22-period CRV long run."

# ---- UALink / UCIe (identical template, same waivers) ----
waiver ualink-line-1 rtl/UALink_top.sv:87-88 line \
  reason="C_SEND-arm line-coverage attribution artifact (5.006); execution proven by 110 received response flits (opcode/txnID/data self-checked)."
waiver ualink-line-2 rtl/UALink_top.sv:93 line \
  reason="default: cstate <= C_IDLE is dead; cstate is 2-bit with all 3 used encodings cased."
waiver ualink-toggle-1 rtl/UALink_top.sv:44 toggle \
  reason="rxrspflit[33:30]: constant response opcode 5'b00001, upper 4 bits never toggle."
waiver ualink-toggle-2 rtl/UALink_top.sv:31 toggle \
  reason="crd_timer[3]: credit timer wraps at 4'd7, bit 3 never set."
waiver ualink-toggle-3 rtl/UALink_top.sv:38 toggle \
  reason="lat_cnt[3]: RSP_LAT=4, counter only takes values 4..0, bit 3 never set."
waiver ucie-line-1 rtl/UCIe_top.sv:87-88 line \
  reason="same as ualink-line-1 (identical template): C_SEND-arm attribution artifact, execution proven by 110 self-checked responses."
waiver ucie-line-2 rtl/UCIe_top.sv:93 line \
  reason="same as ualink-line-2: dead default arm (2-bit state, 3 encodings cased)."
waiver ucie-toggle-1 rtl/UCIe_top.sv:44 toggle \
  reason="same as ualink-toggle-1: constant response opcode upper bits."
waiver ucie-toggle-2 rtl/UCIe_top.sv:31 toggle \
  reason="same as ualink-toggle-2: crd_timer wraps at 4'd7."
waiver ucie-toggle-3 rtl/UCIe_top.sv:38 toggle \
  reason="same as ualink-toggle-3: lat_cnt max value 4, bit 3 never set."

# ---- CXL-family framed-echo template (CXL, PCIe, UEC, Interlaken_v1_2, JESD204C) ----
# Identical 204-line template (rtl/<P>_top.sv), same waivers for all five.
# Line numbers below are identical in all five RTL files.
# (1) Dead default arms:
#   :97  `default: ;` in the tfld sequencer case — tfld is a 3-bit sequencer
#        that only takes values 0..5; 6/7 unreachable by construction.
#   :102 `default: tstate <= T_IDLE;` — tstate 2-bit, encodings 0..2 cased.
#   :186 `default: rstate <= R_IDLE;` — rstate 2-bit, encodings 0..1 cased.
# (2) :159-176 RX END/CRC/rx_done region — Verilator 5.006 line-coverage
#     attribution artifact around the block-local `logic [31:0] c` declaration
#     (counters in the whole region are mis-attributed, e.g. rx_done shows 0
#     while 105 echo frames were byte-verified against the shadow model).
#     Execution proven: 105 echoes only start after rx_done; the sticky
#     rx_err flag is TB-checked after the first bad-STP, each bad-CRC and
#     each bad-END frame.
# (3) Toggle:
#   tmr[15:5]/rtmr[15:5] — BAUD_DIV=20 (counters span 0..19); upper bits are
#     16-bit generic headroom (same convention as uart-toggle-1).
#   buf_mem[0][7:0] — RX store port never selects index 0 (ridx==0 is the STP
#     check, which stores nothing; stores start at ridx==1). Reset-only entry.
#   buf_mem[1][5], len_q[5], tlen[5], ridx[5] — LEN-byte bit5 is len_q[5];
#     len_q>=32 overruns the 24-entry buf_mem (end index 2+len_q+4 > 23), so
#     these bits are unreachable by any non-buffer-overflow frame.
#   rstate[1] — 2-state RX FSM in a 2-bit register; bit 1 constant 0.
#   ta_cnt[3] — TX-arm countdown loaded with the constant 6 (4'd6), bit 3
#     never set.
#   tbit[5] — bit counter wraps at 6'd31 (32-bit CRC field), bit 5 never set.
waiver cxl-fam-line-1 rtl/CXL_top.sv:97 rtl/PCIe_top.sv:97 rtl/UEC_top.sv:97 rtl/Interlaken_v1_2_top.sv:97 rtl/JESD204C_top.sv:97 line \
  reason="dead default arm of tfld sequencer; tfld only takes 0..5 by construction."
waiver cxl-fam-line-2 rtl/CXL_top.sv:102 rtl/PCIe_top.sv:102 rtl/UEC_top.sv:102 rtl/Interlaken_v1_2_top.sv:102 rtl/JESD204C_top.sv:102 line \
  reason="dead default: tstate is 2-bit with encodings 0..2 cased explicitly."
waiver cxl-fam-line-3 rtl/CXL_top.sv:186 rtl/PCIe_top.sv:186 rtl/UEC_top.sv:186 rtl/Interlaken_v1_2_top.sv:186 rtl/JESD204C_top.sv:186 line \
  reason="dead default: rstate is 2-bit with encodings 0..1 cased explicitly."
waiver cxl-fam-line-4 rtl/CXL_top.sv:159-176 rtl/PCIe_top.sv:164-176 rtl/UEC_top.sv:164-176 rtl/Interlaken_v1_2_top.sv:164-176 rtl/JESD204C_top.sv:164-176 line \
  reason="5.006 attribution artifact around block-local logic[31:0] c declaration; execution proven by 105 shadow-verified echo frames and TB-checked sticky rx_err after bad-STP/bad-CRC/bad-END injections."
waiver cxl-fam-toggle-1 rtl/CXL_top.sv:29 rtl/PCIe_top.sv:29 rtl/UEC_top.sv:29 rtl/Interlaken_v1_2_top.sv:29 rtl/JESD204C_top.sv:29 toggle \
  reason="tmr[15:5]: BAUD_DIV=20, counter spans 0..19; upper bits are 16-bit generic headroom."
waiver cxl-fam-toggle-2 rtl/CXL_top.sv:116 rtl/PCIe_top.sv:116 rtl/UEC_top.sv:116 rtl/Interlaken_v1_2_top.sv:116 rtl/JESD204C_top.sv:116 toggle \
  reason="rtmr[15:5]: BAUD_DIV=20, counter spans 0..19; upper bits are 16-bit generic headroom."
waiver cxl-fam-toggle-3 rtl/CXL_top.sv:121 rtl/PCIe_top.sv:121 rtl/UEC_top.sv:121 rtl/Interlaken_v1_2_top.sv:121 rtl/JESD204C_top.sv:121 toggle \
  reason="buf_mem[0][7:0]: RX store port never selects index 0 (ridx==0 STP check stores nothing); reset-only entry."
waiver cxl-fam-toggle-4 rtl/CXL_top.sv:162 rtl/PCIe_top.sv:162 rtl/UEC_top.sv:162 rtl/Interlaken_v1_2_top.sv:162 rtl/JESD204C_top.sv:162 toggle \
  reason="buf_mem[1][5]: LEN bit5 is len_q[5]; len_q>=32 overruns 24-entry buf_mem (end index 2+len_q+4>23), unreachable without buffer overflow."
waiver cxl-fam-toggle-5 rtl/CXL_top.sv:120 rtl/PCIe_top.sv:120 rtl/UEC_top.sv:120 rtl/Interlaken_v1_2_top.sv:120 rtl/JESD204C_top.sv:120 toggle \
  reason="len_q[5]/tlen[5]/ridx[5]: bounded by LEN<=18 valid frames; LEN>=32 is a buffer-overflow condition outside the store array."
waiver cxl-fam-toggle-6 rtl/CXL_top.sv:113 rtl/PCIe_top.sv:113 rtl/UEC_top.sv:113 rtl/Interlaken_v1_2_top.sv:113 rtl/JESD204C_top.sv:113 toggle \
  reason="rstate[1]: 2-state RX FSM in a 2-bit register; bit 1 constant 0."
waiver cxl-fam-toggle-7 rtl/CXL_top.sv:48 rtl/PCIe_top.sv:48 rtl/UEC_top.sv:48 rtl/Interlaken_v1_2_top.sv:48 rtl/JESD204C_top.sv:48 toggle \
  reason="ta_cnt[3]: countdown loaded with constant 4'd6; bit 3 never set."
waiver cxl-fam-toggle-8 rtl/CXL_top.sv:42 rtl/PCIe_top.sv:42 rtl/UEC_top.sv:42 rtl/Interlaken_v1_2_top.sv:42 rtl/JESD204C_top.sv:42 toggle \
  reason="tbit[5]: bit counter wraps at 6'd31 (32-bit CRC field); bit 5 never set."

# ---- CAN-family template (CAN, FlexRay, LIN — identical 253-line RTL) ----
waiver can-fam-line-1 rtl/CAN_top.sv:131 rtl/FlexRay_top.sv:131 rtl/LIN_top.sv:131 line \
  reason="dead default: tstate is a 4-bit enum with all 8 used encodings (0..7) cased explicitly."
waiver can-fam-line-2 rtl/CAN_top.sv:238 rtl/FlexRay_top.sv:238 rtl/LIN_top.sv:238 line \
  reason="dead default arm of rstate case; rstate only takes 0..7 by construction."
waiver can-fam-toggle-1 rtl/CAN_top.sv:32 rtl/FlexRay_top.sv:32 rtl/LIN_top.sv:32 toggle \
  reason="tmr[15:5]: BAUD_DIV=20, counter spans 0..19; upper bits are 16-bit generic headroom."
waiver can-fam-toggle-2 rtl/CAN_top.sv:58 rtl/FlexRay_top.sv:58 rtl/LIN_top.sv:58 toggle \
  reason="run_cnt[3]/rx_run[3]: bit-stuff run counters bounded to 1..5 by the 5-bit stuff rule; bit 3 never set."
waiver can-fam-toggle-3 rtl/CAN_top.sv:53 rtl/FlexRay_top.sv:53 rtl/LIN_top.sv:53 toggle \
  reason="tstate[3]/rstate[3]: 8-state FSMs in 4-bit registers; bit 3 constant 0."
waiver can-fam-toggle-4 rtl/CAN_top.sv:56 rtl/FlexRay_top.sv:56 rtl/LIN_top.sv:56 toggle \
  reason="tx_hdr[6:4]: constant protocol control bits {rtr,ide,r0}=3'b000 loaded at frame start; never toggle."
