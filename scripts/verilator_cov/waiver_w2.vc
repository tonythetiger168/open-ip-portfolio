# v2.5 W2 USB-family coverage waivers (verilator_coverage-style records)
# One record per waived point: ID / file:line / metric / justification.
# These points are provably unreachable or hit the Verilator 5.006
# line-attribution artifact; each is cross-referenced in docs/coverage/W2_USB.md.
# verilator_coverage 5.006 has no -waiver flag, so this file is the source
# of truth for manual/tooling exclusion (same convention as waiver.vc).

# ---- USB3_2 ----
waiver usb32-line-1  rtl/USB3_2_top.sv:159  line \
  reason="Bad-STP rx_err assignment reports DA 0 (5.006 attribution artifact in always_ff case). Execution proven by deterministic wrong-STP probe: rx_err transitions 0->1 on a frame whose only defect is STP!=8'hB3 (TB t==2 transaction), and sticky rx_err is verified by SVA A5."

waiver usb32-line-2  rtl/USB3_2_top.sv:164-176  line \
  reason="END-byte/CRC32-compare/rx_done block reports DA 0 (same artifact family: counts shifted to lines 163/178-181 which show hits). Execution proven: (a) bad-END frames set rx_err with no echo -- only reachable via line 164; (b) 60+ good frames echo with payload compare and irq_cnt==1 -- rx_done (line 176) can only pulse after the CRC compare at lines 166-174 passes."

waiver usb32-line-3  rtl/USB3_2_top.sv:97  line \
  reason="default: ; in tfld case is dead: tfld is 3-bit with values 0-5 explicitly cased, 6-7 unreachable."

waiver usb32-line-4  rtl/USB3_2_top.sv:102  line \
  reason="default: tstate <= T_IDLE is dead: tstate is 2-bit with values 0-2 explicitly cased, value 3 unreachable."

waiver usb32-line-5  rtl/USB3_2_top.sv:186  line \
  reason="default: rstate <= R_IDLE is dead: rstate is 2-bit with values 0-1 explicitly cased, values 2-3 unreachable."

waiver usb32-toggle-1 rtl/USB3_2_top.sv:29,116  toggle \
  reason="tmr[15:5] and rtmr[15:5] never toggle: both counters run 0..BAUD_DIV-1=19 with BAUD_DIV=20, bits [15:5] structurally unreachable under this parameterization."

waiver usb32-toggle-2 rtl/USB3_2_top.sv toggle \
  reason="Counter/enum high bits unreachable by construction: tbit[5] (counts 0..31), tlen[5]/len_q[5] (frame LEN<=HB+MAXB=16), ridx[5] (<=2+16+3=21), ta_cnt[3] (only assigned 6), rstate[1] (2-state enum)."

waiver usb32-toggle-3 rtl/USB3_2_top.sv:121  toggle \
  reason="buf_mem[0], buf_mem[22], buf_mem[23] never written (receiver writes ridx 1..21 only; buf_mem[0] holds its reset value); buf_mem[1][7:6] never set: LEN byte <= 16 in valid frames."

# ---- USB4 (RTL identical to USB3_2 except STP/END constants) ----
waiver usb4-line-1  rtl/USB4_top.sv:159  line \
  reason="Bad-STP rx_err assignment reports DA 0 (5.006 attribution artifact). Execution proven by deterministic wrong-STP probe: rx_err transitions 0->1 on a frame whose only defect is STP!=8'hFB (TB t==2 transaction); sticky rx_err verified by SVA A5."

waiver usb4-line-2  rtl/USB4_top.sv:173,176  line \
  reason="CRC-compare/rx_done lines report DA 0 (same artifact family). Execution proven: 60+ good frames echo with payload compare and irq_cnt==1 -- rx_done (line 176) can only pulse after the CRC compare passes; bad-END frames set rx_err with no echo."

waiver usb4-line-3  rtl/USB4_top.sv:97  line \
  reason="default: ; in tfld case is dead: tfld is 3-bit with values 0-5 explicitly cased, 6-7 unreachable."

waiver usb4-line-4  rtl/USB4_top.sv:102  line \
  reason="default: tstate <= T_IDLE is dead: tstate is 2-bit with values 0-2 explicitly cased, value 3 unreachable."

waiver usb4-line-5  rtl/USB4_top.sv:186  line \
  reason="default: rstate <= R_IDLE is dead: rstate is 2-bit with values 0-1 explicitly cased, values 2-3 unreachable."

waiver usb4-toggle-1 rtl/USB4_top.sv:29,116  toggle \
  reason="tmr[15:5] and rtmr[15:5] never toggle: both counters run 0..BAUD_DIV-1=19 with BAUD_DIV=20, bits [15:5] structurally unreachable under this parameterization."

waiver usb4-toggle-2 rtl/USB4_top.sv toggle \
  reason="Counter/enum high bits unreachable by construction: tbit[5] (counts 0..31), tlen[5]/len_q[5] (frame LEN<=HB+MAXB=16), ridx[5] (<=21), ta_cnt[3] (only assigned 6), rstate[1] (2-state enum)."

waiver usb4-toggle-3 rtl/USB4_top.sv:121  toggle \
  reason="buf_mem[0], buf_mem[22], buf_mem[23] never written (receiver writes ridx 1..21 only); buf_mem[1][7:6] never set: LEN byte <= 16 in valid frames."

# ---- USB2_0 ----
waiver usb20-line-1  rtl/USB2_0_top.sv:214-222  line \
  reason="CRC-fail/echo-launch block reports DA 0 (5.006 attribution artifact in always_ff case with multi-line if/for). Execution proven: bad-CRC frames set rx_err with no echo (only reachable via line 214); every good frame echoes with payload compare and irq_cnt==1 -- rx_done/tx_len/tx_mem copy (lines 215-222) must execute."

waiver usb20-line-2  rtl/USB2_0_top.sv:130  line \
  reason="default: tstate <= T_IDLE is dead: tstate is 2-bit with all 4 encodings explicitly cased."

waiver usb20-line-3  rtl/USB2_0_top.sv:243  line \
  reason="default: rstate <= R_IDLE is dead: rstate is 2-bit with values 0-2 explicitly cased, value 3 unreachable."

waiver usb20-toggle-1 rtl/USB2_0_top.sv:147  toggle \
  reason="buf_mem[11..19] never written: frames carry PID + <=MAXB(8) payload + CRC16 = at most 11 bytes, so ridx stays <= 10."

waiver usb20-toggle-2 rtl/USB2_0_top.sv:21,151  toggle \
  reason="tmr[15:5] and rtmr[15:5] never toggle: both counters run 0..BAUD_DIV-1=19 with BAUD_DIV=20, bits [15:5] structurally unreachable."

waiver usb20-toggle-3 rtl/USB2_0_top.sv toggle \
  reason="Counter/enum high bits unreachable by construction: ridx[5:4] (<=10), rrun[3]/run_cnt[3] (run counters stay <= 7), ta_cnt[3] (only assigned 6), tbit[5:4] (counts 0..15), tx_len[4] (payload <= 8)."

waiver usb20-toggle-4 rtl/USB2_0_top.sv:64  toggle \
  reason="sync_b[6:0] never toggle: sync_b is the constant 8'h80 (tie-off bits)."

# ---- USB_Type_C_Port_Controller ----
waiver tcpc-line-1  rtl/USB_Type_C_Port_Controller_top.sv:126  line \
  reason="default: state <= ST_UNATTACHED is dead: state is 2-bit with values 0-2 explicitly cased, value 3 unreachable."

waiver tcpc-line-2  rtl/USB_Type_C_Port_Controller_top.sv:139  line \
  reason="FAULT_STAT W1C clear reports DA 0 (5.006 attribution artifact in the reg-write case). Execution proven by CRV/directed fault flows: after reg_write(2,8'h01), FAULT_STAT reads back 8'h00 and irq drops -- only possible if this line executed."

waiver tcpc-line-3  rtl/USB_Type_C_Port_Controller_top.sv:169  line \
  reason="default: reg_rdata = 8'h00 is dead: reg_addr is 3-bit with all 8 encodings explicitly cased."

waiver tcpc-line-4  rtl/USB_Type_C_Port_Controller_top.sv:174  line \
  reason="unused tie-off wire: constant 0 by construction (&{1'b0,...}), const-folded, no toggling statement to cover."

waiver tcpc-toggle-1 rtl/USB_Type_C_Port_Controller_top.sv:174  toggle \
  reason="unused tie-off wire is constant 0 (framework-parameter sink), can never toggle."

# ---- USB_PD ----
waiver pd-line-1  rtl/USB_PD_top.sv:247,392,474  line \
  reason="dead default arms: rx_st is 3-bit with values 0-4 cased; tx_st is 4-bit with values 0-7 cased; pe_st is 3-bit with values 0-4 cased. Remaining encodings unreachable."

waiver pd-line-2  rtl/USB_PD_top.sv:444,451,457,461  line \
  reason="PE case-arm condition lines report DA 0 (5.006 attribution artifact for multi-line if conditions; arm bodies at 445-447/452-453/458/462-463 all show hits). Execution proven: full negotiations reach PE_CONTRACT/vbus_ok=1 only through these arms; the GoodCRC-msgid-mismatch CRV scenario exercises lines 452-453 (irq asserted)."

waiver pd-line-3  rtl/USB_PD_top.sv:484  line \
  reason="unused tie-off wire: constant 0 by construction, const-folded, no executable statement to cover."

waiver pd-toggle-1 rtl/USB_PD_top.sv toggle \
  reason="structurally unreachable bits: tx_st[3] (4-bit enum, values 0-7), tx_bit_cnt[5]/bit_cnt[5] (counters 0..31), nobj[2]/rx_nobj[2]/rx_hdr_q[14] (numobj<=2; larger rejected as prot_err before capture), tx_sym[2:1] (K_SYNC1=5'b11000/K_SYNC2=5'b10001 constants), obj_sr[0] (never-read bit: obj_next uses obj_sr[31:1], optimized constant), unused (tie-off)."

waiver pd-toggle-2 rtl/USB_PD_top.sv:261  toggle \
  reason="tx_hdr_q[15:13],[8],[6:2] never toggle: sink TX header templates are fixed -- ext=0, numobj in {0,1} (bits 14-13 = 0), powerrole=0 (sink), specrev=2'b10 (bit 6 = 0), datarole=0 (UFP), mtype in {GoodCRC=5'h01, Request=5'h02} (bits 4-2 = 0)."

waiver pd-toggle-3 rtl/USB_PD_top.sv:410-413  toggle \
  reason="tx_obj_q/rdo_q/rdo_sel dead bits: the RDO is one of two design-fixed values ({pos=2,8'h00,200,200} for the 9V PDO or {pos=1,8'h00,150,150} for the 5V PDO); all other bit patterns are unreachable with the fixed Source_Capabilities set."

# ---- eUSB2 ----
waiver eusb2-line-1  rtl/eUSB2_top.sv:50,75,208,256,269  line \
  reason="Lines report DA 0 (5.006 attribution artifact for statements inside multi-line if/case structures). Execution proven functionally: CRC8 xor (50) -- CRC-validated writes/reads pass; se0_cnt increment (75) -- squelch asserts after long SE0; sync_zeros increment (208) -- sync is acquired on every received packet; is_ctrl arms (256,269) -- control write/read flows complete."

waiver eusb2-line-2  rtl/eUSB2_top.sv:189  line \
  reason="dead guard: the !resp_req else-arm can never be false at EOP -- resp_req is taken by the TX FSM one clock after being set, and control packets are >= 32 clocks long, so a second request can never arrive while resp_req is pending. Defensive RTL."

waiver eusb2-line-3  rtl/eUSB2_top.sv:406  line \
  reason="default: rstate <= R_IDLE is dead: rstate is 3-bit with values 0-5 explicitly cased, values 6-7 unreachable."

waiver eusb2-toggle-1 rtl/eUSB2_top.sv:117  toggle \
  reason="cmd_q[3:0] never toggle: the control CMD byte is {rnw, addr[2:0], 4'b0000} -- the low nibble is protocol-defined 0."
