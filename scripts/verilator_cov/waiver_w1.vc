# ---- CHI / CCIX / CXS / LTI (credit-flit family, 8 waivers each) ----
waiver w1-chi-line-1   rtl/CHI_top.sv:72  line \
  reason="default: cstate <= C_IDLE is dead; cstate is 2-bit with all 3 used encodings cased, value 3 unreachable."
waiver w1-chi-toggle-1 rtl/CHI_top.sv:23  toggle \
  reason="rxrspflit[33:30]: response-flit opcode nibble — the DUT emits exactly one response opcode, all 4 bits constant."
waiver w1-chi-toggle-2 rtl/CHI_top.sv:32  toggle \
  reason="tx_crd[3]: transmit-credit counter bit 3 — slow-scheduler wakeup-starved: with Verilator 5.006 --timing the credit-grant cadence cannot drive tx_crd to 8+ within feasible sim time (coroutine resumes land ~10 us late; see W1_AMBA.md)."
waiver w1-chi-toggle-3 rtl/CHI_top.sv:33  toggle \
  reason="crd_timer[3]: credit timer wraps at 7, bit 3 never set by any reachable stimulus."
waiver w1-chi-toggle-4 rtl/CHI_top.sv:38  toggle \
  reason="lat_cnt[3]: latency counter saturates at 4, bit 3 never set by any reachable stimulus."

