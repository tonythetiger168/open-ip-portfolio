# v2.5 W1 AMBA coverage waivers (verilator_coverage-style records)
# One record per waived point: ID / file:line / metric / justification.
# These points are provably unreachable or un-instrumentable; each is
# cross-referenced in docs/coverage/W1_AMBA.md. verilator_coverage 5.006
# has no -waiver flag, so this file is the source of truth for
# manual/tooling exclusion. See also scripts/verilator_cov/waiver.vc
# (W0 pilots). All line numbers verified against coverage.dat 2026-09-20.

# ---- APB (1) ----
waiver w1-apb-line-1   rtl/APB_top.sv:60  line \
  reason="default: state <= APB_IDLE is dead; state is 1-bit with both encodings (APB_IDLE/APB_ACCESS) cased explicitly."

