waiver avb-line-1 rtl/Ethernet_AVB_TSN_top.sv:131  line \
  reason="default: tstate <= TX_IDLE is dead; tstate only takes encodings 0..7 (all explicitly cased), values 8..15 unreachable."
waiver avb-line-2 rtl/Ethernet_AVB_TSN_top.sv:238  line \
  reason="default: ; in the rstate case is dead; rstate only takes 0..7 (all cased), values 8..15 unreachable."
waiver avb-toggle-1 rtl/Ethernet_AVB_TSN_top.sv    toggle \
  reason="tstate[3], rstate[3]: frame-engine enums only use values 0..7; bit 3 never set."
waiver avb-toggle-2 rtl/Ethernet_AVB_TSN_top.sv    toggle \
