# v2.5 W5 family coverage waivers (verilator_coverage-style records)
# Scope: storage 9 + display/AV 5 + ethernet 6 (see docs/coverage/W5_STORAGE_DISP_ETH.md)
# One record per waived point: ID / file:line / metric / justification.
# Each point is provably unreachable or un-instrumentable; verilator_coverage
# 5.006 has no -waiver flag, so this file is the source of truth for exclusion.

# ---- GMII ----
waiver gmii-line-1   rtl/GMII_top.sv:16  line \
  reason="tx_er port declaration: driven by constant assign tx_er=1'b0 (line 54); constant-folded by Verilator, DA point unhittable. tx_er=0 verified by SVA A2 every clock."

waiver gmii-toggle-1 rtl/GMII_top.sv:17  toggle \
  reason="tx_er is hard-tied to 1'b0 (assign tx_er = 1'b0); can never toggle under any stimulus."

# ---- XGMII ----
waiver xgmii-line-1  rtl/XGMII_top.sv:32  line \
  reason="lane[1:0] declaration: lane is dead state (assigned '0 at lines 35/44, never read); constant-folded, DA point unhittable."

waiver xgmii-line-2  rtl/XGMII_top.sv:73-76  line \
  reason="rxq lane writes: Verilator 5.006 line-coverage attribution artifact (counts shifted). Execution proven by 500+ scoreboard byte compares through exactly these writes (rxc==0 makes all four if-bodies run every data beat)."

waiver xgmii-line-3  rtl/XGMII_top.sv:79-88  line \
  reason="Partial-lane casez arms (4'b0001..4'b1100 + default) sit inside the 'else if (rxv_rise && rxc == 4'h0)' guard, so rxc is constant 0 in the body: every non-0000 arm is provably unreachable dead code."

waiver xgmii-toggle-1 rtl/XGMII_top.sv     toggle \
  reason="count[1:0] and rx_wr[1:0]: rx write pointer only advances by whole 32-bit words (+4 or +3/+2/+1 dead arms); with rxc==0 it always steps +4, so the low two bits are constant 0 and can never toggle."

waiver xgmii-toggle-2 rtl/XGMII_top.sv     toggle \
  reason="tx_rd[1:0]: TX read pointer only advances by +4 (one word per beat); low two bits constant 0, can never toggle."

waiver xgmii-toggle-3 rtl/XGMII_top.sv:32  toggle \
  reason="lane[1:0]: dead state, only assigned '0 at reset; can never toggle."

# ---- MDIO ----
waiver mdio-toggle-1 rtl/MDIO_top.sv:21  toggle \
  reason="cnt[5]: frame bit-counter runs 0..29 (32-bit Clause-22 frame), bit 5 never set by any reachable stimulus."

# ---- echo-frame family: NVMe / FC / Ethernet (identical generated RTL) ----
# Line numbers refer to rtl/NVMe_top.sv; rtl/FC_top.sv and rtl/Ethernet_top.sv
# are byte-identical except the header comment, so the same lines apply.

waiver nvme-line-1 rtl/NVMe_top.sv:97    line \
  reason="default: ; in the tfld case: tfld only ever takes values 0..5 (all explicitly cased); 6/7 unreachable."
waiver nvme-line-2 rtl/NVMe_top.sv:102   line \
  reason="default: tstate <= T_IDLE is dead; tstate is 2-bit with all 3 used encodings cased, value 3 unreachable."
waiver nvme-line-3 rtl/NVMe_top.sv:159,164-176 line \
  reason="RX error/CRC block: Verilator 5.006 line-attribution artifact (block-local 'logic [31:0] c' declaration inside always_ff shifts DA counts). Execution proven functionally: bad-STP sets rx_err (line 159), bad-END sets rx_err (164), good frames pulse rx_done (176) and bad-CRC sets rx_err (175) — all checked by CRV self-checks."
waiver nvme-line-4 rtl/NVMe_top.sv:186   line \
  reason="default: rstate <= R_IDLE is dead; rstate only takes 0/1 (both cased), values 2/3 unreachable."

waiver nvme-toggle-1 rtl/NVMe_top.sv     toggle \
  reason="buf_mem[0][*] and buf_mem[22][*], buf_mem[23][*]: index 0 is reset-only (STP byte is never stored), indices 22/23 exceed the max write index (2+len_q+3 <= 21 for len_q <= 16). Provably unreachable."
waiver nvme-toggle-2 rtl/NVMe_top.sv     toggle \
  reason="buf_mem[1][7:5]: buf_mem[1] stores LEN = 8+plen <= 16, bits 5..7 never set."
waiver nvme-toggle-3 rtl/NVMe_top.sv     toggle \
  reason="len_q[5], tlen[5], ridx[5], rstate[1], ta_cnt[3], tbit[5]: counters bounded by frame geometry (len<=16, ridx<=22, rstate<=1, ta_cnt<=6, tbit<=31); these bits never set."
waiver nvme-toggle-4 rtl/NVMe_top.sv     toggle \
  reason="tmr[15:5], rtmr[15:5]: baud counters run 0..BAUD_DIV-1 (19); bits 5 and above never set."

waiver fc-line-1 rtl/FC_top.sv:97    line reason="see nvme-line-1 (identical RTL)."
waiver fc-line-2 rtl/FC_top.sv:102   line reason="see nvme-line-2 (identical RTL)."
waiver fc-line-3 rtl/FC_top.sv:159,164-176 line reason="see nvme-line-3 (identical RTL; same functional proofs via FC CRV)."
waiver fc-line-4 rtl/FC_top.sv:186   line reason="see nvme-line-4 (identical RTL)."
waiver fc-toggle-1 rtl/FC_top.sv     toggle reason="see nvme-toggle-1 (identical RTL)."
waiver fc-toggle-2 rtl/FC_top.sv     toggle reason="see nvme-toggle-2 (identical RTL)."
waiver fc-toggle-3 rtl/FC_top.sv     toggle reason="see nvme-toggle-3 (identical RTL)."
waiver fc-toggle-4 rtl/FC_top.sv     toggle reason="see nvme-toggle-4 (identical RTL)."

waiver eth-line-1 rtl/Ethernet_top.sv:97    line reason="see nvme-line-1 (identical RTL)."
waiver eth-line-2 rtl/Ethernet_top.sv:102   line reason="see nvme-line-2 (identical RTL)."
waiver eth-line-3 rtl/Ethernet_top.sv:159,164-176 line reason="see nvme-line-3 (identical RTL; same functional proofs via Ethernet CRV)."
waiver eth-line-4 rtl/Ethernet_top.sv:186   line reason="see nvme-line-4 (identical RTL)."
waiver eth-toggle-1 rtl/Ethernet_top.sv     toggle reason="see nvme-toggle-1 (identical RTL)."
waiver eth-toggle-2 rtl/Ethernet_top.sv     toggle reason="see nvme-toggle-2 (identical RTL)."
waiver eth-toggle-3 rtl/Ethernet_top.sv     toggle reason="see nvme-toggle-3 (identical RTL)."
waiver eth-toggle-4 rtl/Ethernet_top.sv     toggle reason="see nvme-toggle-4 (identical RTL)."

