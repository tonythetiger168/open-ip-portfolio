# ---- eMMC ----
waiver emmc-line-1 rtl/eMMC_top.sv:119,211,250,270,274,284,287,293-297,410,422 line \
  reason="Verilator 5.006 attribution artifacts on declaration/guard/macro lines (same class as nvme-line-3/sata-line-1): error-flag decl (119), constant-1 bit_tick guard (211), and multi-line EMMC_RAISE macro expansion sites (250,270,274,284,287,293-297,410,422) lose their DA points. Execution proven by TB self-checks: 120-txn CRV observed err_timeout set 34x (mute), err_crc7 set (corrupted R1), err_crc16 set (corrupted read block) — each followed by a verified recovery round."
waiver emmc-line-2 rtl/eMMC_top.sv:174,178,179 line \
  reason="bit_tick/bd_cnt: BIT_CLKS=1 makes bit_tick constant 1; bd_cnt else/incr arm dead, decl constant-folded (same as sata-line-4)."
