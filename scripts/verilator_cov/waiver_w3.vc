# ---- MIPI_I3C ----
waiver mi3c-line-1 rtl/MIPI_I3C_top.sv:449  line \
  reason="default: state <= S_IDLE is dead; state is 5-bit with 15 used encodings cased explicitly, values 15-31 unreachable."

waiver mi3c-toggle-1 rtl/MIPI_I3C_top.sv:96  toggle \
  reason="bcnt[3]: byte bit-counter wraps at 4'd7/4'd8, bit 3 never set by any reachable stimulus."

waiver mi3c-toggle-2 rtl/MIPI_I3C_top.sv:108  toggle \
  reason="pid_cnt[3]: PID byte index counts 0..5, bit 3 never set."

waiver mi3c-toggle-3 rtl/MIPI_I3C_top.sv:114  toggle \
  reason="arb_word[1,3,5,7]: arb_word = {dyn_addr,1'b1} with dyn_addr fixed at 7'h2A after the single ENTDAA; even data bits are constant 0."

waiver mi3c-toggle-4 rtl/MIPI_I3C_top.sv:117,123  toggle \
  reason="pid_byte[4]/pid_byte_n[4]: combinational PID-byte mux output; Verilator 5.006 toggle instrumentation reports 0 despite the mux selecting bytes with differing bit4 (functional proof: 13 CRV GETPID flows compare all 6 PID bytes, which requires the mux to deliver 0x45/0x89 with bit4=1)."

waiver mi3c-toggle-5 rtl/MIPI_I3C_top.sv:30  toggle \
  reason="dyn_addr[0,2,4,6]: assigned once by ENTDAA to 7'h2A (even bits constant 0) and never reassigned."

waiver mi3c-toggle-6 rtl/MIPI_I3C_top.sv:59  toggle \
  reason="state[4]: 15 legal states (0..14), bit 4 never set."

# ---- MIPI_DPI ----
waiver mdpi-line-1 rtl/MIPI_DPI__Display_Pixel_Interface__top.sv:94  line \
  reason="else if (reg_addr == 4'd8): Verilator 5.006 line-attribution artifact (branch shifted to the neighbouring line). Execution proven: every one of the ~230 ctrl writes (enables, disables, shutdown/resume, invalid-config rejections) passes through this arm and their registered effects are all self-checked."

# ---- C_PHY ----
waiver cphy-line-1 rtl/C_PHY_top.sv:228  line \
  reason="default: tstate <= T_IDLE is dead; tstate is a 2-bit enum and all four encodings (T_IDLE/T_SYNC/T_DATA/T_STOP) are cased explicitly."
waiver cphy-line-2 rtl/C_PHY_top.sv:289-292  line \
  reason="R_IDLE sync-start arm: Verilator 5.006 line-attribution artifact. Execution proven: every one of the ~85 loopback packets (directed + CRV) enters R_SYNC only through this arm and all rx words compare correctly."
waiver cphy-line-3 rtl/C_PHY_top.sv:300-306  line \
  reason="R_SYNC sync-match arm: Verilator 5.006 line-attribution artifact. Execution proven: R_DATA (whose rx_valid words all self-check) is reachable only via the r_spos==6 path of this arm; the else arm is proven by the bad-sync error class raising irq."
waiver cphy-line-4 rtl/C_PHY_top.sv:341  line \
  reason="default: rstate <= R_IDLE is dead; rstate is a 2-bit enum and all four encodings (R_IDLE/R_SYNC/R_DATA/R_ERR) are cased explicitly."
waiver cphy-toggle-1 rtl/C_PHY_top.sv:154  toggle \
  reason="tx_d16[15:3]: base-5 digit r_val%5 only takes values 0..4; the upper 13 bits are constant-tied to 0 and can never toggle."
waiver cphy-toggle-2 rtl/C_PHY_top.sv:251  toggle \
  reason="r_acc[31:16]: partial base-5 accumulation of the first 6 digits is bounded by 4*(1+5+25+125+625+3125)=15624; the upper bits are constant-tied to 0 and can never toggle."
waiver cphy-toggle-3 rtl/C_PHY_top.sv:264  toggle \
  reason="r_word[31:16]: the reconstructed word equals the transmitted 16-bit word (<=16'hFFFF) for every legal symbol stream; upper bits constant-tied to 0, only reachable via illegal streams that take the error arms instead."

# ---- D_PHY ----
waiver dphy-line-1 rtl/D_PHY_top.sv:300  line \
  reason="default: tstate <= T_STOP is dead; tstate is a 5-bit enum whose 18 used encodings are all cased explicitly; the default arm is only reachable through state corruption."
waiver dphy-line-2 rtl/D_PHY_top.sv:431  line \
  reason="R_HS1 else-if (rlp != LP_01): Verilator 5.006 line-attribution artifact. Execution proven: the arm's body (err_sticky + R_ERR) is covered and the CRV hs1-violation class (LP-01 followed by LP-10) passes its irq self-check."
waiver dphy-line-3 rtl/D_PHY_top.sv:582  line \
  reason="default: rstate <= R_STOP is dead; rstate is a 4-bit enum whose 15 used encodings are all cased explicitly; encoding 15 never occurs."
waiver dphy-toggle-1 rtl/D_PHY_top.sv:126  toggle \
  reason="trig_cnt[2]: the Trigger Mark-1 hold counter wraps at 3'd3 (T_TRIG exits at trig_cnt==3), so bit 2 is constant-tied to 0 and can never toggle."

# ---- CSI_2 (run_cov needs VERILATOR_TEST_FLAGS=-Wno-BLKANDNBLK: rtl eb/hc
#      mix blocking/nonblocking assignments -- recorded, not fixed) ----
waiver csi-line-1 rtl/CSI_2_top.sv:95-109  line \
  reason="ecc_bit syndrome-decode table: Verilator 5.006 line-attribution artifact for multi-item case lines inside functions. Execution proven: the closure sweep injects a single-bit error at every one of the 24 header + 6 ECC-bit positions and every packet corrects and commits (line_cnt/lb self-checked) -- only possible through these arms."
waiver csi-line-2 rtl/CSI_2_top.sv:217  line \
  reason="short-packet default arm (generic DT): attribution artifact. Execution proven: CRV short-mix sends random DTs 0x4-0xF whose (non-)effect on frame/line counts is scoreboard-checked."
waiver csi-line-3 rtl/CSI_2_top.sv:226  line \
  reason="S_ECC corrected-path else-if: attribution artifact. Execution proven: 30+ corrected packets per run commit with err_flags[3] set."
waiver csi-line-4 rtl/CSI_2_top.sv:252,254-256  line \
  reason="S_ECC uncorrectable arm: attribution artifact. Execution proven: the ECC double-bit class checks irq + err_flags[1] + line not committed on every iteration."
waiver csi-line-5 rtl/CSI_2_top.sv:285  line \
  reason="default: state <= S_SYNC is dead; state is 3-bit and all 8 encodings (S_SYNC..S_CRC1) are cased explicitly."
waiver csi-toggle-1 rtl/CSI_2_top.sv:149-150  toggle \
  reason="wc[15:10]/pay_cnt[15:10]: packets are bounded to <=520 payload bytes (the line buffer is 512 deep; longer packets only add serial runtime without new behavior). Upper bits never toggle in the verified envelope."
waiver csi-toggle-2 rtl/CSI_2_top.sv:161  toggle \
  reason="lb_len[15:10]: lb_len = min(wc, 512) can never exceed 512; the upper six bits are constant-tied to 0."
waiver csi-toggle-3 rtl/CSI_2_top.sv:157  toggle \
  reason="line_cnt[15:13]: the closure walk commits 4200 lines in one frame (bits 12:0 toggle); >=8192-line frames are a sim-practicality limit, not a design bound."
waiver csi-toggle-4 rtl/CSI_2_top.sv:156  toggle \
  reason="frame_cnt[15:11]: the closure walk runs 1100 FS/FE pairs (bits 10:0 toggle); >=2048-frame runs are a sim-practicality limit, not a design bound."
waiver csi-toggle-5 rtl/CSI_2_top.sv:71  toggle \
  reason="eb[5]: the syndrome index only takes values 0..29 (24 data + 6 ECC positions; uncorrectable syndromes return 63 but are not assigned to eb), so bit 5 is constant-tied to 0."
waiver csi-toggle-6 rtl/CSI_2_top.sv:72  toggle \
  reason="hc[23:18]: hc is the ECC-corrected header; its [23:8] field is the packet word count, bounded to <=520 in the verified envelope (see csi-toggle-1), so [23:18] never toggle."
