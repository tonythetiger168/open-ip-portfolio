{
  "title": "CAN 2.0A/B controller",
  "code": "0x4341",
  "version": "2.0",
  "tb_clk_ns": 10,
  "tb_timeout": "60ms",
  "regs": [
    {"name": "BTR", "kind": "rw", "desc": "Bit timing (static while the bus is in use)",
     "fields": [{"port": "cfg_brp", "reset": "1", "desc": "time quantum = BRP+1 clocks"},
                {"port": "cfg_tseg1", "reset": "5", "desc": "TSEG1 = TSEG1+1 tq (propagation + phase 1)"},
                {"port": "cfg_tseg2", "reset": "2", "desc": "TSEG2 = TSEG2+1 tq (phase 2)"},
                {"port": "cfg_sjw", "reset": "1", "desc": "resynchronisation jump width = SJW+1 tq (at most TSEG2+1)"}]},
    {"name": "ACC_CODE", "kind": "rw", "desc": "Acceptance code",
     "fields": [{"port": "acc_code", "desc": "ID to match (base IDs in bits 10:0)"}]},
    {"name": "ACC_MASK", "kind": "rw", "desc": "Acceptance mask",
     "fields": [{"port": "acc_mask", "desc": "1 = the ID bit must equal ACC_CODE; 0 accepts every frame"}]},
    {"name": "TX", "kind": "stream_in", "data": ["tx_data", "tx_id", "tx_ide", "tx_rtr", "tx_dlc"],
     "valid": "tx_valid", "ready": "tx_ready",
     "desc": "Frame to transmit; writing TX3 (DLC) queues it",
     "fdesc": {"tx_data": "data bytes, byte 0 in bits 7:0 (sent first)", "tx_id": "identifier (base frames: bits 10:0)",
               "tx_ide": "1 = extended frame", "tx_rtr": "1 = remote frame", "tx_dlc": "data length code"}},
    {"name": "CMD", "kind": "cmd", "desc": "Commands",
     "fields": [{"port": "tx_abort", "desc": "1 = drop the queued frame when it is not being sent (IRQ ABORTED)"}]},
    {"name": "RX", "kind": "stream_out", "data": ["rx_data", "rx_id", "rx_ide", "rx_rtr", "rx_dlc"],
     "valid": "rx_valid", "desc": "Received frame; reading RX3 frees it",
     "fdesc": {"rx_data": "data bytes, byte 0 in bits 7:0", "rx_id": "identifier", "rx_ide": "extended frame",
               "rx_rtr": "remote frame", "rx_dlc": "data length code"}},
    {"name": "STATUS", "kind": "ro", "desc": "Fault confinement",
     "fields": [{"port": "tec", "desc": "transmit error counter"}, {"port": "rec", "desc": "receive error counter"},
                {"port": "err_passive", "desc": "error passive"}, {"port": "bus_off", "desc": "bus-off"}]}
  ],
  "irqs": [
    {"name": "SENT", "port": "tx_done", "desc": "a queued frame was sent"},
    {"name": "ABORTED", "port": "tx_aborted", "desc": "a queued frame was dropped by CMD.tx_abort"},
    {"name": "ARB_LOST", "port": "arb_lost", "desc": "arbitration lost (the frame is retried)"},
    {"name": "ERR_BIT", "port": "err_bit", "desc": "bit error"},
    {"name": "ERR_STUFF", "port": "err_stuff", "desc": "stuff error"},
    {"name": "ERR_CRC", "port": "err_crc", "desc": "CRC error"},
    {"name": "ERR_FORM", "port": "err_form", "desc": "form error"},
    {"name": "ERR_ACK", "port": "err_ack", "desc": "acknowledgement error"},
    {"name": "ERR_PASSIVE", "port": "err_passive", "desc": "node is error passive (level)"},
    {"name": "BUS_OFF", "port": "bus_off", "desc": "node is bus-off (level)"}
  ]
}
