        },
        {
          "port": "start1",
          "desc": "queue channel 1"
        },
        {
          "port": "start2",
          "desc": "queue channel 2"
        },
        {
          "port": "start3",
          "desc": "queue channel 3"
        }
      ]
    },
    {
      "name": "STATUS",
      "kind": "ro",
      "desc": "Scheduler state",
      "fields": [
        {
          "port": "pending",
          "desc": "queued channels"
        },
        {
          "port": "busy",
          "desc": "a job is running"
        },
        {
          "port": "active_ch",
          "desc": "channel of the current / last job"
        },
        {
          "port": "err",
          "desc": "the current / last job saw an AXI error response"
        }
      ]
    },
    {
      "name": "CHECKSUM",
      "kind": "ro",
      "desc": "Data checksum",
      "fields": [
