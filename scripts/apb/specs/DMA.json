          "port": "cycles",
          "desc": "clocks from start to DONE of the current / last job"
        }
      ]
    }
  ],
  "irqs": [
    {
      "name": "DONE0",
      "port": "done0",
      "desc": "a channel 0 job ended"
    },
    {
      "name": "DONE1",
      "port": "done1",
      "desc": "a channel 1 job ended"
    },
    {
      "name": "DONE2",
      "port": "done2",
      "desc": "a channel 2 job ended"
    },
    {
      "name": "DONE3",
      "port": "done3",
      "desc": "a channel 3 job ended"
    },
    {
      "name": "ERR",
      "port": "err_irq",
      "desc": "a job ended that saw an AXI error response"
    }
  ],
  "sequence": [
    "Write SRCn, DSTn, LENn (and FILLn), MODE and IRQ_ENABLE.",
    "Write CMD with startn = 1 for each channel to run; channels may be queued while one runs.",
    "On irq read IRQ_STATUS to see which DONEn are set, then write them back to clear."
  ],
  "notes": [
    "m_* is the AXI4 manager port (32-bit address and data, 4-bit ID, no user / QoS); it passes through unchanged. Bursts are INCR, AxSIZE = 2 (4 bytes), 1 to 16 beats, WSTRB = 4'hF, never across a 4 KB boundary; one read and one write burst are outstanding at a time. A read burst is issued only when its data has room, a write burst only when all its data is ready."
  ]
}
