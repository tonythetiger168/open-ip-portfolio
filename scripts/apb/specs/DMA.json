        {
          "port": "len1",
          "reset": "0",
          "desc": "32-bit words"
        }
      ]
    },
    {
      "name": "FILL1",
      "kind": "rw",
      "desc": "Channel 1 fill word",
      "fields": [
        {
          "port": "fill1",
