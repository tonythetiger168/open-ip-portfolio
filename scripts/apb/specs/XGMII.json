{
  "title": "XGMII MAC-side interface: TX bytes packed into 32-bit columns through a FIFO into the tx_clk domain, an RX capture ring of the data lanes sampled from rx_clk",
  "code": "0x5847",
  "version": "2.0",
  "tb_clk_ns": 10,
  "regs": [
    {
      "name": "STATUS",
      "kind": "ro",
      "desc": "RX capture count",
      "fields": [
        {
          "port": "count",
          "desc": "data lanes captured (wraps at 32); entry count mod 16 is written next"
        }
      ]
    },
    {
      "name": "CORE",
      "kind": "bus",
      "wen": "wen",
      "waddr": "waddr",
      "wdata": "wdata",
      "ren": "ren",
      "raddr": "raddr",
      "rdata": "rdata",
      "words": [
        {
          "name": "TX",
          "w": 0,
          "desc": "Byte to send, packed lane 0 first; the fourth byte pushes the column (dropped while the 4-column FIFO is full) (write-only)"
        },
        {
          "name": "EOF",
          "w": 1,
          "desc": "End of frame: pushes a partly filled column, idle (0x07, txc set) in the unused lanes; nothing when no byte is held or while the FIFO is full (write-only, data ignored)"
        },
        {
          "name": "RX0",
          "r": 0,
          "desc": "RX capture ring entry 0"
        },
        {
