{
  "title": "MIPI DSI host transmitter, packet layer on a 1 bit per clock HS lane: short and long packets with header ECC and CRC-16, DCS writes, video-mode lines, DCS read with bus turn-around and an ECC-checked response",
  "code": "0x4453",
  "version": "2.0",
  "tb_clk_ns": 10,
  "tb_timeout": "100ms",
  "pins": [
    "tx_oe"
  ],
  "regs": [
    {
      "name": "CMD",
      "kind": "rw",
      "desc": "Command",
      "fields": [
        {
          "port": "cmd_op",
          "reset": "0",
          "desc": "0 raw short packet (DT cmd_dt, data LEN), 1 DCS short write without parameter, 2 DCS short write with PL0 as parameter, 3 DCS long write of LEN payload bytes, 4 video line (HSS, HSE, HBP of LEN2 zero bytes, HACT of LEN bytes), 5 DCS read and bus turn-around; 6 and 7 are rejected (ERROR)"
        },
        {
          "port": "cmd_dt",
          "reset": "0",
          "desc": "data type of a raw short packet"
        },
        {
          "port": "cmd_dcs",
          "reset": "0",
          "desc": "DCS command byte"
        }
      ]
    },
    {
      "name": "LEN",
      "kind": "rw",
      "desc": "Lengths",
      "fields": [
        {
          "port": "cmd_len",
          "reset": "0",
          "desc": "raw short packet data, long-write length or HACT length (a payload above 32 bytes, or HACT not a multiple of 3, is rejected: ERROR)"
        },
        {
          "port": "cmd_len2",
          "reset": "0",
          "desc": "HBP blanking length of a video line"
        }
      ]
    },
    {
      "name": "GO",
      "kind": "cmd",
      "desc": "Start",
      "fields": [
        {
          "port": "cmd_valid",
          "desc": "write 1: run CMD with LEN (ignored while STATUS.busy)"
        }
      ]
    },
    {
