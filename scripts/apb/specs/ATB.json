{
  "title": "AMBA ATB trace sink: a 16-beat capture buffer flushed when the trace ID changes, read back through the registers",
  "code": "0x4154",
  "version": "2.0",
  "tb_clk_ns": 10,
  "regs": [
    {
      "name": "STATUS",
      "kind": "ro",
      "desc": "Capture buffer state",
      "fields": [
        {
          "port": "count",
          "desc": "beats captured since the last flush (16: full, atready low)"
        },
        {
          "port": "last_id",
          "desc": "ATID of the last beat accepted with atlast"
        }
      ]
    },
    {
      "name": "CORE",
      "kind": "bus",
      "ren": "ren",
      "raddr": "raddr",
      "rdata": "rdata",
      "words": [
        {
          "name": "D0",
          "r": 0,
          "desc": "Capture buffer entry 0"
        },
        {
          "name": "D1",
          "r": 1,
          "desc": "Capture buffer entry 1"
        },
        {
          "name": "D2",
          "r": 2,
          "desc": "Capture buffer entry 2"
        },
        {
          "name": "D3",
          "r": 3,
          "desc": "Capture buffer entry 3"
        },
        {
          "name": "D4",
          "r": 4,
          "desc": "Capture buffer entry 4"
        },
        {
          "name": "D5",
          "r": 5,
          "desc": "Capture buffer entry 5"
        },
        {
          "name": "D6",
          "r": 6,
          "desc": "Capture buffer entry 6"
        },
        {
          "name": "D7",
          "r": 7,
          "desc": "Capture buffer entry 7"
        },
        {
          "name": "D8",
          "r": 8,
          "desc": "Capture buffer entry 8"
        },
        {
          "name": "D9",
          "r": 9,
          "desc": "Capture buffer entry 9"
        },
        {
          "name": "D10",
          "r": 10,
          "desc": "Capture buffer entry 10"
        },
        {
          "name": "D11",
          "r": 11,
          "desc": "Capture buffer entry 11"
        },
        {
          "name": "D12",
          "r": 12,
          "desc": "Capture buffer entry 12"
        },
        {
          "name": "D13",
          "r": 13,
          "desc": "Capture buffer entry 13"
        },
        {
          "name": "D14",
          "r": 14,
          "desc": "Capture buffer entry 14"
        },
        {
          "name": "D15",
          "r": 15,
          "desc": "Capture buffer entry 15"
        }
      ]
    }
  ],
  "irqs": [
    {
      "name": "LAST",
      "port": "irq",
      "desc": "a beat with atlast was accepted"
    }
  ],
  "notes": [
    "atvalid, atready, atdata, atid, atlast, afvalid and afready are the ATB slave pins; they pass through unchanged. afvalid with an ATID other than the current one flushes the buffer (count back to 0) and makes that ID current; afready is always 1. Beats fill entries 0 to 15 in order."
  ]
}