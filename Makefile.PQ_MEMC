# SPDX-License-Identifier: Apache-2.0
# PQ_MEMC Open IP (TV SoC picture quality: HDR tone mapping + MEMC blend, AXI4 manager) -- sim & synthesis entry points
S      := PQ_MEMC
DEPS   := rtl/pq/pq_stages.sv rtl/soc_ss_axi_engine.sv rtl/tv_fifo.sv
SIM    ?= iverilog
VFLAGS := -g2012 -Wall
SYN    ?= yosys

all: sim syn

sim:
	$(SIM) $(VFLAGS) -I tb -o simv rtl/$(S)_top.sv $(DEPS) tb/$(S)_tb.sv
	./simv

syn:
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_yosys.ys

# the same core and TB with the private pq-pipeline-sv stages (fetched by
# scripts/ext/fetch_pq.sh into the git-ignored ext/pq/)
PQ_EXT := ext/pq/pq_pkg.sv ext/pq/l0_metadata_unit.sv ext/pq/l1_tone_map_eetf.sv ext/pq/l2d_memc_blend.sv
sim_ext:
	test -f ext/pq/l1_tone_map_eetf.sv || bash scripts/ext/fetch_pq.sh
	$(SIM) $(VFLAGS) -DPQ_EXT -I tb -o simv_ext $(PQ_EXT) rtl/$(S)_top.sv rtl/soc_ss_axi_engine.sv rtl/tv_fifo.sv tb/$(S)_tb.sv
	./simv_ext

apb:
	$(SIM) $(VFLAGS) -I tb -o simv_apb rtl/$(S)_top.sv $(DEPS) rtl/$(S)_apb.sv tb/$(S)_apb_tb.sv
	./simv_apb
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_apb_yosys.ys

clean:
	rm -f simv simv_apb *.vcd work/*.json work/*_netlist.v
.PHONY: all sim syn apb clean
