# SPDX-License-Identifier: Apache-2.0
# SDMMC_ADMA Open IP (SD / eMMC host with ADMA2, IP camera SoC) -- sim & synthesis entry points
S      := SDMMC_ADMA
DEPS   := rtl/soc_ss_axi_engine.sv
TBDEPS := tb/soc_ss_axi_mem.svh tb/sdmmc_card_model.svh   # after the TB: they take the TB's timescale
SIM    ?= iverilog
VFLAGS := -g2012 -Wall
SYN    ?= yosys

all: sim syn

sim:
	$(SIM) $(VFLAGS) -I tb -o simv rtl/$(S)_top.sv $(DEPS) tb/$(S)_tb.sv
	./simv

syn:
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_yosys.ys

apb:
	$(SIM) $(VFLAGS) -I tb -o simv_apb rtl/$(S)_top.sv $(DEPS) rtl/$(S)_apb.sv tb/$(S)_apb_tb.sv $(TBDEPS)
	./simv_apb
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_apb_yosys.ys

clean:
	rm -f simv simv_apb *.vcd work/*.json work/*_netlist.v
.PHONY: all sim syn apb clean
