# SPDX-License-Identifier: Apache-2.0
# DDR4_JEDEC_AXI Open IP (AXI4 DDR4 controller on real JEDEC pins) -- sim & synthesis entry points
# sim: iverilog (default) or SIM=verilator (5.x, --timing). The testbench uses a
# behavioural PHY and device model with timed DQS (tb/ddr4_phy_beh.sv, tb/ddr4_dev_model.sv).
S       := DDR4_JEDEC_AXI
DEPS    := rtl/ddr4_jedec_ctrl.sv
TBDEPS  := tb/ddr4_phy_beh.sv tb/ddr4_dev_model.sv
SIM     ?= iverilog
VFLAGS  := -g2012
VLFLAGS := --binary --timing --timescale 1ps/1ps -j 0 -Wno-fatal -Wno-lint -Wno-style -Wno-ZERODLY -Wno-TIMESCALEMOD
SYN     ?= yosys

all: sim syn

ifeq ($(SIM),verilator)
sim:
	verilator $(VLFLAGS) --top-module $(S)_tb -Mdir obj_$(S) rtl/$(S)_top.sv $(DEPS) $(TBDEPS) tb/$(S)_tb.sv
	./obj_$(S)/V$(S)_tb
else
sim:
	$(SIM) $(VFLAGS) -o simv rtl/$(S)_top.sv $(DEPS) $(TBDEPS) tb/$(S)_tb.sv
	vvp -n simv
endif

syn:
	mkdir -p work && cd work && $(SYN) -p "read_verilog -sv ../rtl/ddr4_jedec_ctrl.sv ../rtl/$(S)_top.sv; synth -top $(S)_top; stat"

apb:
	$(SIM) $(VFLAGS) -I tb -o simv_apb rtl/$(S)_top.sv $(DEPS) rtl/$(S)_apb.sv $(TBDEPS) tb/$(S)_apb_tb.sv
	vvp -n simv_apb
	mkdir -p work && cd work && $(SYN) ../syn/$(S)_apb_yosys.ys

clean:
	rm -rf simv simv_apb obj_$(S) work/*.json
.PHONY: all sim syn apb clean
